# foundry-studio configuration
# Copy to .env and adjust as needed. All values can also be set as
# FOUNDRY_STUDIO_* environment variables.

# --- Server ---------------------------------------------------------------
# FOUNDRY_STUDIO_HOST=127.0.0.1
# FOUNDRY_STUDIO_PORT=8765
# Allow binding to 0.0.0.0 (LAN access). Use behind TLS + auth for real use.
# FOUNDRY_STUDIO_ALLOW_REMOTE_ACCESS=false

# --- Storage ---------------------------------------------------------------
# Where jobs, inputs, outputs and logs live.
# FOUNDRY_STUDIO_DATA_DIR=~/.foundry-studio

# --- Engine behaviour ------------------------------------------------------
# auto | real | simulation
# auto: use real Foundry engines when packages + checkpoints exist, else the
#       labelled simulation engine (clearly marked in the UI).
# FOUNDRY_STUDIO_ENGINE_MODE=auto
# FOUNDRY_STUDIO_ALLOW_SIMULATION_FALLBACK=true

# --- Checkpoints -------------------------------------------------------------
# Extra checkpoint search dirs, colon-separated (same as FOUNDRY_CHECKPOINT_DIRS).
# FOUNDRY_STUDIO_CHECKPOINT_DIRS=

# --- Workers ---------------------------------------------------------------
# FOUNDRY_STUDIO_WORKER_AUTOSTART=true
# FOUNDRY_STUDIO_WORKER_POLL_INTERVAL=2.0

# --- Frontend ----------------------------------------------------------------
# Absolute path to the built frontend (frontend/dist). When unset, the API
# serves JSON only and the dev server (npm run dev) is used instead.
# FOUNDRY_STUDIO_FRONTEND_DIST=D:/GIthub/foundry-studio/frontend/dist
